# Database (DB_ENGINE: mysql | postgresql)
DB_ENGINE=mysql
# Set a full URL, or leave empty and use DB_* below
DATABASE_URL=

# Required when DATABASE_URL is empty: DB_USER, DB_HOST, DB_NAME
DB_HOST=localhost
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=your_schema
CONVERSATION_TABLE=user_consultation
ANALYSIS_TABLE=conversation_analysis

# AI / OpenAI Batch (run.py)
MODEL_API_KEY=
MODEL_NAME=gpt-5-nano
OPENAI_JSON_SCHEMA_STRICT=true
BATCH_MIN_TURNS=10
# Cap total sessions per run (empty = no cap)
BATCH_MAX_SESSIONS=
# Sessions with MAX(created_at) on turns >= this window
BATCH_CONVERSATION_SINCE_DAYS=90
# Or fixed UTC instant instead of days: BATCH_CONVERSATION_SINCE=2025-01-01T00:00:00+00:00
BATCH_SHARD_SIZE=5000
BATCH_WORK_DIR=batch_work
BATCH_MANIFEST_JSON=manifest.json
BATCH_POLL_INTERVAL_SEC=15
BATCH_WAIT_FOR_COMPLETION=true
BATCH_COMPLETED_SESSIONS_CACHE=batch_completed_sessions.json
BATCH_SKIP_COMPLETED=true
# Also skip session_ids already present in conversation_analysis
BATCH_SKIP_ALREADY_ANALYZED=true
# test.py: optional preview rows before full pipeline (0 = skip preview)
BATCH_TEST_PREVIEW=3
DEBUG=
