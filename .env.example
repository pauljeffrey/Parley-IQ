# Database (DB_ENGINE: mysql | postgresql)
DB_ENGINE=mysql
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/your_database

# Optional if DATABASE_URL is unset
AISHA_DB_HOST=localhost
AISHA_DB_PORT=
AISHA_DB_USER=
AISHA_DB_PASSWORD=
AISHA_DB_NAME=
AISHA_DB_SCHEMA=aisha
# AISHA_ANALYSIS_TABLE=aisha_conversation_analysis

# AI / OpenAI Batch (run.py)
MODEL_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=gpt-5-nano
OPENAI_JSON_SCHEMA_STRICT=true
BATCH_MAX_SESSIONS=
BATCH_POLL_INTERVAL_SEC=15
BATCH_WAIT_FOR_COMPLETION=true
BATCH_INPUT_JSONL=batch_input.jsonl
BATCH_OUTPUT_JSONL=batch_output.jsonl
BATCH_ERROR_JSONL=batch_errors.jsonl
BATCH_META_JSON=batch_meta.json
DEBUG=
