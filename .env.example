# =============================================================================
# Parley-IQ environment (see run.py + batch_processor.py)
# =============================================================================
#
# LOCAL DOCKER MYSQL
#   DB_HOST=127.0.0.1
#   MYSQL_ROOT_PASSWORD=devroot   (compose + scripts/seed_conversations.py only)
#   docker compose up -d
#   py scripts/seed_conversations.py
#
# PRODUCTION
#   DB_HOST=<prod host>           (e.g. azureaggregatedprod.sproxil.us)
#   DB_USER / DB_PASSWORD / DB_NAME / DB_SCHEMA / CONVERSATION_TABLE / ANALYSIS_TABLE
#   Remove or ignore MYSQL_ROOT_PASSWORD
#   Optional: DATABASE_URL instead of DB_* (overrides built URL)
#
# FULL SHARDED BATCH (all pending sessions, large shards)
#   BATCH_SHARD_SIZE=20000          # max SESSIONS per OpenAI batch job (not message pairs)
#   BATCH_MAX_SESSIONS=             # empty = no cap; set only for smoke tests (e.g. 3)
#   BATCH_MIN_TURNS=5               # skip sessions with fewer turn rows
#   BATCH_CONVERSATION_SINCE_DAYS=  # empty = no date filter; or e.g. 90 for recent only
#   BATCH_CONVERSATION_SINCE=       # optional fixed UTC lower bound (overrides DAYS if set)
#   BATCH_SKIP_COMPLETED=true       # skip session_ids in BATCH_COMPLETED_SESSIONS_CACHE
#   BATCH_SKIP_ALREADY_ANALYZED=true # skip session_ids already in ANALYSIS_TABLE
#   BATCH_WAIT_FOR_COMPLETION=true  # poll OpenAI until done, then insert analysis rows
#   BATCH_POLL_INTERVAL_SEC=15
#   BATCH_WORK_DIR=batch_work       # shard JSONL: batch_work/shard_0000/input.jsonl, ...
#   BATCH_MANIFEST_JSON=manifest.json
#   BATCH_COMPLETED_SESSIONS_CACHE=batch_completed_sessions.json
#
# OPENAI
#   MODEL_API_KEY=
#   MODEL_NAME=gpt-5-nano
#   OPENAI_JSON_SCHEMA_STRICT=true
#
# RETRIES: Only successfully inserted sessions are cached. Failed/skipped persist
#   sessions are NOT cached and are eligible on the next py run.py (if still in DB filters).
#
# Legacy (ignored by sharded run.py): BATCH_INPUT_JSONL, BATCH_OUTPUT_JSONL, etc.
# test.py only: BATCH_TEST_PREVIEW=3
# =============================================================================

# Database (DB_ENGINE: mysql | postgresql)
DB_ENGINE=mysql
DATABASE_URL=

DB_HOST=127.0.0.1
DB_PORT=
MYSQL_ROOT_PASSWORD=devroot
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=your_schema
CONVERSATION_TABLE=user_consultation
ANALYSIS_TABLE=conversation_analysis

MODEL_API_KEY=
MODEL_NAME=gpt-5-nano
OPENAI_JSON_SCHEMA_STRICT=true

BATCH_MIN_TURNS=10
BATCH_MAX_SESSIONS=
BATCH_CONVERSATION_SINCE_DAYS=90
BATCH_CONVERSATION_SINCE=
BATCH_SHARD_SIZE=5000
BATCH_WORK_DIR=batch_work
BATCH_MANIFEST_JSON=manifest.json
BATCH_POLL_INTERVAL_SEC=15
BATCH_WAIT_FOR_COMPLETION=true
BATCH_COMPLETED_SESSIONS_CACHE=batch_completed_sessions.json
BATCH_SKIP_COMPLETED=true
BATCH_SKIP_ALREADY_ANALYZED=true
BATCH_TEST_PREVIEW=3
DEBUG=
